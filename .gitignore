# Backend local runtime data
backend/db.sqlite3
backend/chroma_data/
backend/staticfiles/
backend/.cache/
backend/media/

# ChromaDB 也可能被建在專案根目錄（看啟動時的 cwd）。
chroma_data/

# Claude Code 的本機設定與快取。settings.json 若日後要做為團隊共用設定，
# 把這條改成只忽略 .claude/settings.local.json 即可。
.claude/

# 根目錄的臨時資料傾印（語料分析結果、輸入測試紀錄等）。研究資料要進版控
# 的話請放進 scripts/ 或 docs/ 底下並明確 git add，不要留在專案根目錄。
/*.csv
/*.txt

# ML classifier weights (~391MB each) — copy in separately, see
# backend/apps/matching/ml_models/nuclear_node_model/README.md
backend/apps/matching/ml_models/*/model_macro/model.safetensors
backend/apps/matching/ml_models/*/model_micro_*/model.safetensors

# Godot web build (~52MB generated artifact) — export locally from godot/,
# see GodotLobby.jsx. Not version-controlled; each dev exports their own.
frontend/public/godot/

# Frontend local dependencies / build output
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Swap / temp
*.swp
*.swo

