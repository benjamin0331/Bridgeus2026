server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # 研究者上傳知識庫影片用。沒有這一行的話 nginx 會套預設的 1MB 上限，
  # 任何真實影片都會在到達 Django 之前就被擋掉，回一個沒有 JSON body 的
  # 413 HTML 頁——前端的錯誤解析拿不到 detail，只會顯示「新增影片失敗」，
  # 完全看不出原因（2026-09 實際踩到過）。
  #
  # 這個值刻意比後端的 KB_VIDEO_MAX_BYTES（預設 200MB）大一些：讓「只超過
  # 一點點」的檔案能走到 Django，拿到「上限是 200 MB，請先壓縮」這種說得
  # 清楚的錯誤，而不是 nginx 這個無訊息的 413。兩邊要一起調。
  client_max_body_size 220m;

  location /api/ {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # 研究者上傳的知識庫影片檔（Django MEDIA_ROOT，由 serve_media 提供，
  # 支援 HTTP Range）。VideoRecommendation.url 存根相對路徑 /media/...，
  # <video src> 用站台 origin 解析，所以這裡要原封不動轉到後端。
  location /media/ {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /ws/ {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Godot 常駐 headless server 的 WebSocket 多人連線（非 Django Channels，
  # 是 Godot 自己的 WebSocketMultiplayerPeer，見 godot/World/game.gd）。
  # 常駐 server 跑在 host 上（systemd，非容器內），走 host.docker.internal
  # 觸及，跟 BACKEND_HOST 同樣的 extra_hosts 映射即可。
  location /godot-ws {
    proxy_pass http://${GODOT_WS_HOST}:${GODOT_WS_PORT};
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Godot Web build：.html/.js/.wasm/.pck 四個檔必須永遠成套。JS glue 跟 wasm
  # 對不上的症狀是 `import a:a must be an object`，進度條會卡在最後一格
  # （檔案其實下載完了，死在 instantiate）。這件事會反覆發生的原因是三者的
  # 快取行為不一致：38MB 的 .wasm 與 20MB 的 .pck 超過 CDN 可快取的物件大小，
  # 永遠是新的，偏偏只有 280KB 的 .js 會被邊緣與瀏覽器留下來——於是每次改版
  # 都可能變成「舊 js + 新 wasm」。
  #
  # no-cache 不是不快取，是「每次都帶 ETag 回來問一次」：檔沒變回 304，流量
  # 幾乎不變，但改版當下一定拿到新的。
  #
  # ⚠️ Cloudflare 端要兩件事配合，否則這段等於沒寫：
  #    1. Caching → Configuration → Browser Cache TTL 設 Respect Existing Headers
  #       （預設會把回應改寫成 max-age=14400，瀏覽器四小時內不會再問伺服器）
  #    2. Cache Rule：路徑符合 /godot/* → Bypass cache
  location ^~ /godot/ {
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
