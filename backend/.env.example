DJANGO_SECRET_KEY=replace-with-at-least-32-characters
JWT_SIGNING_KEY=replace-with-at-least-32-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,dev.bridgeus.work
PORT=8005
UVICORN_WORKERS=1
UVICORN_TIMEOUT_KEEP_ALIVE=180
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,https://dev.bridgeus.work
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,https://dev.bridgeus.work
REDIS_URL=redis://redis:6379/1
USE_REDIS_CACHE=false
USE_REDIS_CHANNEL=false
DJANGO_PASSWORD_MIN_LENGTH=8
ALLOW_COMMON_PASSWORDS=false
ALLOW_NUMERIC_PASSWORDS=false
MATCHING_QUEUE_HEARTBEAT_TIMEOUT_SECONDS=15
MATCHING_ALLOW_SAME_STANCE_FALLBACK=false
MATCH_ROOM_IDLE_TIMEOUT_SECONDS=600
MATCH_ROOM_ABSENCE_TIMEOUT_SECONDS=180
H_H_AI_ASSIST_ENABLED=false
# AI 開場（H-AI 與 H-H 皆適用）；關掉時兩邊都不生成開場。
AI_OPENING_ENABLED=true
H_H_AI_ASSIST_TIMEOUT_SECONDS=2
PRELOAD_NLP_MODELS=false
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.4-mini
OPENAI_API_TIMEOUT_SECONDS=20
SEMANTIC_TREE_ANALYZE_BATCH_SIZE=5

# ── CCND 節點分析：本地 ML 模型 vs GPT API ──────────────────────────────
# 注意：settings.py 讀的是「backend/.env」（這個檔案的同層），不是專案根目錄的
# .env。docker-compose.yml 的 env_file 指向的才是根目錄那個，兩邊設定要一致。
# 改完一定要重啟伺服器，os.getenv 只在 process 啟動時從 .env 載入一次。
#
# 預設行為：topic 102（核電）、103（女性義務兵役）走本地 BERT 分類器，
# 其餘議題（101、104…）走 OpenAI。權重檔每個約 391MB、未進版控，
# 必須從共用空間複製到 backend/apps/matching/ml_models/ 底下。
#
# 逐議題改走 GPT API 版本（逗號分隔），適合正式機：
#   SEMANTIC_TREE_AI_TOPIC_IDS=103   ← 核電保留 ML，女性義務兵役走 API
SEMANTIC_TREE_AI_TOPIC_IDS=
# 全部議題一律走 GPT API，忽略本地模型。開發機沒有權重檔時用這個：
SEMANTIC_TREE_FORCE_AI=false
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
# 自助改密碼（POST /api/me/password/）的限流。這個端點會驗 old_password，
# 等於一個密碼 oracle。已認證請求依 user id 計數，不會受同場地共用 NAT 影響。
THROTTLE_CHANGE_PASSWORD=5/min
DB_ENGINE=sqlite
DB_NAME=bridgeus
DB_USER=postgres
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=true
SQLITE_PATH=db.sqlite3
CHROMA_PERSIST_DIR=chroma_data
HF_HOME=.cache/huggingface
DEFAULT_DIALOGUE_COLLECTION=general_knowledge
# 整個系統用哪家模型：claude（預設，現行版本）/ openai（備案）。
# 認不得的值一律當成 claude。切換需要重啟服務才會生效——DialogueAgent 有快取。
# 自動 failover 是刻意不做的：一場對話中途換模型，那批實驗資料就不可解讀了。
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=replace-me
CLAUDE_CHAT_MODEL=claude-sonnet-4-6
CLAUDE_CHAT_MAX_TOKENS=1024
# 備案用。OPENAI_API_KEY 同時也是 CCND 節點分析（semantic_tree）在用的那把。
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_CHAT_MAX_TOKENS=1536
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GODOT_SERVICE_TOKEN=replace-me

# 知識庫影片上傳（研究者設定頁 → 影片管理）。
# KB_VIDEO_MAX_MB 是後端的單檔上限；nginx 的 client_max_body_size
# （frontend/nginx/default.conf.template）要設得比它大一些，兩邊一起調，
# 否則使用者會拿到 nginx 那個沒有訊息的 413 而不是說得清楚的錯誤。
KB_VIDEO_MAX_MB=200
KB_VIDEO_ALLOWED_EXTENSIONS=mp4,webm,mov,m4v
# 上傳檔案的存放目錄。不設的話是 <backend>/media，會跟著 checkout 走——
# 伺服器上有多份 checkout 共用同一顆 DB 時，務必設成 checkout 之外的絕對路徑，
# 否則「A 份收到上傳、之後換 B 份對外服務」的影片會 404。
MEDIA_ROOT=/srv/bridgeus_media
